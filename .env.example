# --- Voice agent ---
# "mock" runs a scripted, rule-based conversation partner with zero external calls.
# "assemblyai" uses the real managed Voice Agent API (STT+LLM+TTS in one session).
VOICE_AGENT_PROVIDER=mock
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_WS_URL=wss://agents.assemblyai.com/v1/ws
# Voice id for TTS output — check AssemblyAI's current voice catalog and adjust if needed.
ASSEMBLYAI_VOICE_ID=ivy

# --- Database ---
POSTGRES_USER=speakquest
POSTGRES_PASSWORD=speakquest
POSTGRES_DB=speakquest
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://speakquest:speakquest@localhost:5432/speakquest

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000
